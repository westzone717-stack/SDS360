# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/sds360?retryWrites=true&w=majority

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx
REDIS_URL=redis://localhost:6379

# NextAuth - Admin App
ADMIN_NEXTAUTH_SECRET=your-admin-secret-min-32-chars
ADMIN_NEXTAUTH_URL=https://admin.sds360.com

# NextAuth - Customer App
APP_NEXTAUTH_SECRET=your-app-secret-min-32-chars
APP_NEXTAUTH_URL=https://app.sds360.com

# LLM Providers
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
OLLAMA_BASE_URL=http://localhost:11434

# AWS S3
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=ap-northeast-1
AWS_S3_BUCKET=sds360-documents

# Email (Resend)
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@sds360.com

# App URLs
ADMIN_URL=https://admin.sds360.com
APP_URL=https://app.sds360.com
